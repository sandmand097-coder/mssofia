# mrsofia — copy to .env on the local development computer.
# Never commit .env. Never put keys in the frontend or chat messages.
PORT=4010
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=GENERATE_AT_LEAST_48_RANDOM_CHARACTERS

# Production: persistent Supabase PostgreSQL connection string, e.g. from Database > Connect > Pooler.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# PGSSL=required
# For Render Free, use Supabase SESSION pooler (IPv4), not the IPv6-only direct database host.
# Use backend role mssofia_backend.[PROJECT_REF] created in the database.
PG_POOL_MAX=6

# Admin is created by local bootstrap CLI; production admin invitation requires verified sender email.
# Do not expose default development credentials.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=ONLY_FOR_SEEDING_DEMO_IN_LOCAL_DEVELOPMENT
DEMO_TEACHER_EMAIL=teacher@example.invalid
DEMO_TEACHER_PASSWORD=LOCAL_DEMO_ONLY
DEMO_STUDENT_EMAIL=student@example.invalid
DEMO_STUDENT_PASSWORD=LOCAL_DEMO_ONLY

# LiveKit Cloud WSS URL and server-only keys; local development can use localhost LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email provider; verified sender required for outgoing production messages.
MAIL_FROM=
RESEND_API_KEY=
# Alternative SMTP (do not configure both SMTP and Resend unless intentional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Registration is fail-closed in production until mail service, policies and admin are ready.
REGISTRATION_ENABLED=false
PUBLIC_LAUNCH_MODE=preview
SCHOOL_PRIVACY_APPROVED=false
SCHOOL_CONTACT_EMAIL=
# Required only when Vodafone Cash receipts are enabled.
VODAFONE_CASH_NUMBER=01027661546
SCHOOL_SUPPORT_PHONE=01027661546
SCHOOL_ADMIN_EMAIL=

# Google Identity Services: verified administrator login, NOT student signup.
# Enabled only after a Google Cloud Web OAuth Client is configured.
# Never grant admin rights based only on a Gmail address.
GOOGLE_ADMIN_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Custom domain cutover: keep pages.dev and Cloudflare same-origin /api proxy
# until Render has valid TLS on api.mssofia.com.
# Cloudflare Pages: API_ORIGIN=https://mssofia.onrender.com (then https://api.mssofia.com)
# Frontend: https://mssofia.com; Render APP_ORIGIN=https://mssofia.com
# COOKIE_DOMAIN=mssofia.com   # only after custom-domain HTTPS migration
COOKIE_DOMAIN=

# WhatsApp: OFF by default. NEVER expose any secret as VITE_*.
# Both templates MUST be approved as Meta Utility templates with 4 body vars.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar
SCHOOL_PUBLIC_URL=https://mssofia.pages.dev
# Worker sends Bearer secret to server-only /api/internal/notifications/tick
NOTIFICATION_CRON_SECRET=
# Cloudflare Worker ONLY: NOTIFICATION_TICK_URL=https://api.mssofia.com/api/internal/notifications/tick
# Contacts can receive messages only after verified guardian opt-in in notification_contacts.
